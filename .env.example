# =============================
# LiveKit Plugins Env Template
# =============================
# Copy this file to `.env` and fill in your real credentials.
# Never commit real keys/tokens.


# -----------------------------
# Aliyun (DashScope)
# -----------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key_here


# -----------------------------
# MiniMax
# -----------------------------
MINIMAX_API_KEY=your_minimax_api_key_here
# Optional: only set when your account/gateway requires GroupId
MINIMAX_GROUP_ID=


# -----------------------------
# Volcengine
# -----------------------------
# TTS
VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_tts_access_token_here

# STT (recommended: new console key)
VOLCENGINE_STT_API_KEY=your_volcengine_stt_api_key_here

# STT (legacy mode, optional if API_KEY is set)
VOLCENGINE_STT_APP_ID=
VOLCENGINE_STT_ACCESS_TOKEN=

# LLM
VOLCENGINE_LLM_API_KEY=your_volcengine_llm_api_key_here

# Realtime
VOLCENGINE_REALTIME_APP_ID=your_volcengine_realtime_app_id_here
VOLCENGINE_REALTIME_ACCESS_TOKEN=your_volcengine_realtime_access_token_here

# Optional override base URL for LLM-compatible clients
VOLCENGINE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3


# -----------------------------
# Tencent
# -----------------------------
# STT
TENCENT_STT_APP_ID=your_tencent_stt_app_id_here
TENCENT_STT_SECRET_ID=your_tencent_stt_secret_id_here
TENCENT_STT_SECRET_KEY=your_tencent_stt_secret_key_here

# TTS
TENCENT_TTS_APP_ID=your_tencent_tts_app_id_here
TENCENT_TTS_SECRET_ID=your_tencent_tts_secret_id_here
TENCENT_TTS_SECRET_KEY=your_tencent_tts_secret_key_here


# -----------------------------
# Xunfei
# -----------------------------
XUNFEI_STT_APP_ID=your_xunfei_stt_app_id_here
XUNFEI_STT_API_KEY=your_xunfei_stt_api_key_here


# -----------------------------
# Zhipu
# -----------------------------
ZHIPU_LLM_API_KEY=your_zhipu_llm_api_key_here
# Optional override base URL for LLM-compatible clients
ZHIPU_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/


# -----------------------------
# Dify
# -----------------------------
DIFY_API_KEY=your_dify_api_key_here
DIFY_API_BASE=https://api.dify.ai/v1
# Optional user id used by Dify plugin
DIFY_USER=test_user


# -----------------------------
# Baidu
# -----------------------------
BAIDU_APP_ID=your_baidu_app_id_here
BAIDU_API_KEY=your_baidu_api_key_here


# -----------------------------
# StepFun
# -----------------------------
STEPFUN_REALTIME_API_KEY=your_stepfun_realtime_api_key_here


# -----------------------------
# FlashTTS
# -----------------------------
FLASHTTS_API_KEY=your_flashtts_api_key_here
# Note: code reads FLASHTTS_BASE_URL
FLASHTTS_BASE_URL=http://localhost:8000
# Some docs mention FLASHTTS_API_URL; keep if your deployment uses it.
FLASHTTS_API_URL=http://localhost:8000


# -----------------------------
# Optional tooling / telemetry
# -----------------------------
SENTRY_DSN=
PYPI_TOKEN=
